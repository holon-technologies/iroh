#!/usr/bin/env bash

set -euo pipefail

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
readonly script_path
script_dir="$(dirname "$script_path")"
readonly script_dir
default_repo_root="$(git -C "$script_dir/.." rev-parse --show-toplevel)"
readonly default_repo_root
readonly repo_root="${KRIKOS_REPO_ROOT:-$default_repo_root}"
readonly dockerfile="${KRIKOS_TEST_DOCKERFILE:-$repo_root/docker/Dockerfile.test-env}"
readonly entrypoint="${KRIKOS_TEST_ENTRYPOINT:-$repo_root/docker/test-env-entrypoint}"
readonly build_jobs="${KRIKOS_TEST_BUILD_JOBS:-2}"

if [[ -n "${KRIKOS_TEST_IMAGE:-}" ]]; then
    readonly image="$KRIKOS_TEST_IMAGE"
else
    dockerfile_hash="$(sha256sum "$dockerfile" | cut -d ' ' -f 1)"
    readonly dockerfile_hash
    readonly image="krikos-test-env:ubuntu-24.04-${dockerfile_hash:0:12}"
fi

if ! docker image inspect "$image" >/dev/null 2>&1; then
    docker build \
        --tag "$image" \
        --file "$dockerfile" \
        "$(dirname "$dockerfile")"
fi

if [[ $# -eq 0 ]]; then
    # Patchbay's checked-in Nextest profile is single-threaded because each
    # case creates a complete network lab. Preserve that isolation when the
    # full workspace is run through plain Cargo.
    set -- scripts/run-all-tests.sh
fi

exec docker run --rm \
    --privileged \
    --security-opt apparmor=unconfined \
    --mount "type=bind,src=$repo_root,dst=/source,readonly" \
    --mount "type=bind,src=$entrypoint,dst=/usr/local/bin/iroh-test-entrypoint,readonly" \
    --mount "type=volume,src=iroh-test-cargo-registry,dst=/root/.cargo/registry" \
    --mount "type=volume,src=iroh-test-cargo-git,dst=/root/.cargo/git" \
    --mount "type=volume,src=iroh-test-target,dst=/cargo-target" \
    --tmpfs /overlay:exec,mode=755,size=4294967296 \
    --env "CARGO_BUILD_JOBS=$build_jobs" \
    --env CARGO_TARGET_DIR=/cargo-target \
    --env GIT_CONFIG_COUNT=1 \
    --env GIT_CONFIG_KEY_0=safe.directory \
    --env GIT_CONFIG_VALUE_0=/workspace \
    --workdir /workspace \
    --entrypoint /usr/local/bin/iroh-test-entrypoint \
    "$image" \
    "$@"

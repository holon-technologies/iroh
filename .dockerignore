# Deny everything, then allow only what the workspace build needs.
# docker/Dockerfile does `COPY . .` for the cargo-chef planner and builder,
# so this allowlist is the sole bound on context size.
*

!Cargo.toml
!Cargo.lock
!.cargo/

# Prebuilt release binaries staged at the repo root by .github/workflows/docker.yaml
# before invoking docker/Dockerfile.ci with `context: .`.
!bins/

!krikos/
!krikos-base/
!krikos-dns/
!krikos-dns-server/
!krikos-relay/
!krikos-resolver/
!krikos-runtime/
!tools/
!framework/
!examples/
!integration-tests/
!protocols/

# Only the two crates referenced by [patch.crates-io] in the root Cargo.toml.
# vendor/rustls-0.23.41 is patched in by krikos-sim and fuzz only, neither of
# which this image builds.
!vendor/hickory-server-0.26.1/
!vendor/noq-1.1.0/

# Re-exclude build output inside the directories allowed above.
**/target

+    #[derive(Default)]
+    struct CountingObserver {
+        udp_rejected: AtomicUsize,
+        udp_active: AtomicUsize,
+        tcp_rejected: AtomicUsize,
+        tcp_active: AtomicUsize,
+    }
+
+    impl AdmissionObserver for CountingObserver {
+        fn admitted(&self, kind: AdmissionKind) {
+            match kind {
+                AdmissionKind::UdpRequest => {
+                    self.udp_active.fetch_add(1, Ordering::SeqCst);
+                }
+                AdmissionKind::TcpConnection => {
+                    self.tcp_active.fetch_add(1, Ordering::SeqCst);
+                }
+            }
+        }
+
+        fn released(&self, kind: AdmissionKind) {
+            match kind {
+                AdmissionKind::UdpRequest => {
+                    self.udp_active.fetch_sub(1, Ordering::SeqCst);
+                }
+                AdmissionKind::TcpConnection => {
+                    self.tcp_active.fetch_sub(1, Ordering::SeqCst);
+                }
+            }
+        }
+
+        fn rejected(&self, rejection: AdmissionRejection) {
+            match rejection {
+                AdmissionRejection::UdpRequestCapacity => {
+                    self.udp_rejected.fetch_add(1, Ordering::SeqCst);
+                }
+                AdmissionRejection::TcpConnectionCapacity => {
+                    self.tcp_rejected.fetch_add(1, Ordering::SeqCst);
+                }
+            }
+        }
+    }

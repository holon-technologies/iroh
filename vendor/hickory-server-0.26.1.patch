+const DEFAULT_MAX_UDP_REQUESTS: NonZeroUsize =
+    NonZeroUsize::new(1_024).expect("default UDP request limit is nonzero");
+const DEFAULT_MAX_TCP_CONNECTIONS: NonZeroUsize =
+    NonZeroUsize::new(256).expect("default TCP connection limit is nonzero");
+
+/// Hard limits applied before DNS request and connection tasks are spawned.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ServerLimits {
+    max_udp_requests: NonZeroUsize,
+    max_tcp_connections: NonZeroUsize,
+}
+
+impl ServerLimits {
+    /// Creates limits for concurrent UDP requests and accepted TCP connections.
+    pub const fn new(
+        max_udp_requests: NonZeroUsize,
+        max_tcp_connections: NonZeroUsize,
+    ) -> Self {
+        Self {
+            max_udp_requests,
+            max_tcp_connections,
+        }
+    }
+}
+
+impl Default for ServerLimits {
+    fn default() -> Self {
+        Self::new(
+            DEFAULT_MAX_UDP_REQUESTS,
+            DEFAULT_MAX_TCP_CONNECTIONS,
+        )
+    }
+}
+
+/// A resource governed by server admission.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum AdmissionKind {
+    /// One executing UDP request.
+    UdpRequest,
+    /// One accepted TCP connection.
+    TcpConnection,
+}
+
+/// A request or connection rejected before task creation.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum AdmissionRejection {
+    /// The UDP request capacity is full.
+    UdpRequestCapacity,
+    /// The TCP connection capacity is full.
+    TcpConnectionCapacity,
+}
+
+/// Observes bounded admission without influencing its outcome.
+pub trait AdmissionObserver: Send + Sync + 'static {
+    /// Called after capacity is acquired and before task creation.
+    fn admitted(&self, _kind: AdmissionKind) {}
+
+    /// Called when an owned admission lease releases its capacity.
+    fn released(&self, _kind: AdmissionKind) {}
+
+    /// Called when capacity is unavailable and no task is created.
+    fn rejected(&self, _rejection: AdmissionRejection) {}
+}
+
+#[derive(Debug, Default)]
+struct NoopAdmissionObserver;
+
+impl AdmissionObserver for NoopAdmissionObserver {}
+
+struct AdmissionControl {
+    udp_requests: Arc<Semaphore>,
+    tcp_connections: Arc<Semaphore>,
+    observer: Arc<dyn AdmissionObserver>,
+}
+
+impl AdmissionControl {
+    fn new(limits: ServerLimits, observer: Arc<dyn AdmissionObserver>) -> Self {
+        Self {
+            udp_requests: Arc::new(Semaphore::new(limits.max_udp_requests.get())),
+            tcp_connections: Arc::new(Semaphore::new(limits.max_tcp_connections.get())),
+            observer,
+        }
+    }
+
+    fn try_admit(&self, kind: AdmissionKind) -> Option<AdmissionLease> {
+        let semaphore = match kind {
+            AdmissionKind::UdpRequest => &self.udp_requests,
+            AdmissionKind::TcpConnection => &self.tcp_connections,
+        };
+        match semaphore.clone().try_acquire_owned() {
+            Ok(permit) => {
+                self.observer.admitted(kind);
+                Some(AdmissionLease {
+                    _permit: permit,
+                    kind,
+                    observer: self.observer.clone(),
+                })
+            }
+            Err(_) => {
+                let rejection = match kind {
+                    AdmissionKind::UdpRequest => AdmissionRejection::UdpRequestCapacity,
+                    AdmissionKind::TcpConnection => AdmissionRejection::TcpConnectionCapacity,
+                };
+                self.observer.rejected(rejection);
+                None
+            }
+        }
+    }
+}
+
+struct AdmissionLease {
+    _permit: OwnedSemaphorePermit,
+    kind: AdmissionKind,
+    observer: Arc<dyn AdmissionObserver>,
+}
+
+impl Drop for AdmissionLease {
+    fn drop(&mut self) {
+        self.observer.released(self.kind);
+    }
+}

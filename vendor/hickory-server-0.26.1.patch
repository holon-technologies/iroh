+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let mut server = Server::with_limits(Catalog::new(), limits, observer.clone());
+        server.register_listener(listener, Duration::from_secs(30), 32);
+        let shutdown = server.shutdown_token().clone();
+        let server_task = tokio::spawn(async move { server.block_until_done().await });
+
+        let first = TokioTcpStream::connect(addr).await.unwrap();
+        timeout(Duration::from_secs(2), async {
+            while observer.tcp_active.load(Ordering::SeqCst) != 1 {
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("first TCP connection should be admitted");
+        let mut excess = Vec::new();
+        for _ in 0..10 {
+            excess.push(TokioTcpStream::connect(addr).await.unwrap());
+        }
+        wait_for_rejection(&observer.tcp_rejected).await;
+
+        assert_eq!(observer.tcp_active.load(Ordering::SeqCst), 1);
+        drop(excess);
+        drop(first);
+        shutdown.cancel();
+        server_task.await.unwrap().unwrap();
+        assert_eq!(observer.tcp_active.load(Ordering::SeqCst), 0);
+    }
 }

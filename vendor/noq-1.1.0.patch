+#[tokio::test(start_paused = true)]
+async fn guarded_connection_tokens_live_until_noq_state_is_fully_drained() -> TestResult {
+    let factory = EndpointFactory::new();
+    let endpoint = factory.endpoint("lifetime-token");
+    let address = endpoint.local_addr()?;
+    let outgoing_dropped = Arc::new(AtomicUsize::new(0));
+    let incoming_dropped = Arc::new(AtomicUsize::new(0));
+
+    let outgoing = endpoint.connect_with_lifetime(
+        address,
+        "localhost",
+        ConnectionLifetimeToken::new(TokenDropFlag(outgoing_dropped.clone())),
+    )?;
+    let incoming = endpoint.accept().await.unwrap();
+    let accepting = incoming.accept_with_lifetime(ConnectionLifetimeToken::new(TokenDropFlag(
+        incoming_dropped.clone(),
+    )))?;
+    let (outgoing, incoming) = tokio::try_join!(outgoing, accepting)?;
+
+    drop(outgoing);
+    drop(incoming);
+    assert_eq!(outgoing_dropped.load(Ordering::SeqCst), 0);
+    assert_eq!(incoming_dropped.load(Ordering::SeqCst), 0);
+
+    endpoint.close(0u32.into(), b"test complete");
+    tokio::time::sleep(Duration::from_secs(5)).await;
+    endpoint.wait_idle().await;
+
+    assert_eq!(outgoing_dropped.load(Ordering::SeqCst), 1);
+    assert_eq!(incoming_dropped.load(Ordering::SeqCst), 1);
+    Ok(())
+}
+
+struct TokenDropFlag(Arc<AtomicUsize>);
+
+impl Drop for TokenDropFlag {
+    fn drop(&mut self) {
+        self.0.fetch_add(1, Ordering::SeqCst);
+    }
+}

+struct StaticKxGroup(&'static dyn SupportedKxGroup);
+
+#[cfg(any(feature = "ring", feature = "aws_lc_rs"))]
+impl SupportedKxGroup for StaticKxGroup {
+    fn start(&self) -> Result<Box<dyn ActiveKeyExchange>, Error> {
+        self.0.start()
+    }
+
+    fn start_and_complete(&self, peer_pub_key: &[u8]) -> Result<CompletedKeyExchange, Error> {
+        self.0.start_and_complete(peer_pub_key)
+    }
+
+    fn ffdhe_group(&self) -> Option<FfdheGroup<'static>> {
+        self.0.ffdhe_group()
+    }
+
+    fn name(&self) -> NamedGroup {
+        self.0.name()
+    }
+
+    fn fips(&self) -> bool {
+        self.0.fips()
+    }
+
+    fn usable_for_version(&self, version: ProtocolVersion) -> bool {
+        self.0.usable_for_version(version)
+    }
+}
+
+#[cfg(any(feature = "ring", feature = "aws_lc_rs"))]
+pub(crate) fn owned_kx_groups(
+    groups: &[&'static dyn SupportedKxGroup],
+) -> Vec<Arc<dyn SupportedKxGroup>> {
+    groups
+        .iter()
+        .map(|group| {
+            let owned: Arc<dyn SupportedKxGroup> = Arc::new(StaticKxGroup(*group));
+            owned
+        })
+        .collect()
+}

# Set line endings to LF, even on Windows. Otherwise, execution within CI fails.
# See https://help.github.com/articles/dealing-with-line-endings/
* text=auto eol=lf
*.sh text eol=lf

# Upstream code carrying a narrow patch. Not this project's work, and it should
# not appear in GitHub's language statistics or dominate diff review.
vendor/** linguist-vendored

# Vendored trees and their patches must stay byte-identical to the upstream
# crates.io packages, or scripts/tests/check-vendor-provenance.sh cannot verify
# them. Exempt from the repo-wide LF normalization above.
vendor/** -text

# Machine-generated. Excluded from language statistics and collapsed in diffs.
# `**/CHANGELOG.md` covers the root changelog and every per-crate one (new
# workspace members get this for free instead of needing their own line).
**/CHANGELOG.md linguist-generated
docs/history/CHANGELOG_old.md linguist-generated
**/Cargo.lock linguist-generated
docs/testing/resource-canary/** linguist-generated

# Canonical identity fixtures and fuzz corpora are byte strings, even when a
# particular seed happens to be valid UTF-8. Never normalize or text-diff them.
protocols/krikos-identity/tests/vectors/*.bin binary linguist-generated
fuzz/corpus/identity_*/* binary linguist-generated
